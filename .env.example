PORT=3000
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
# Optional: auth:youtube stores the refresh token in the ignored tokens.json file.
# GOOGLE_REFRESH_TOKEN=
# Optional: set this if ffprobe.exe is not available on PATH.
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# Optional: set this if Puppeteer's downloaded Chrome is not available.
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
